generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  ORGANIZER
}

enum Status {
  ACTIVE
  PENDING_APPROVAL
  SUSPENDED
  BLOCKED
}

model Company {
  id                 String    @id @default(uuid())
  name               String
  document           String?
  status             Status    @default(ACTIVE)
  secretKey          String?
  autoApproveWithKey Boolean   @default(true)
  createdAt          DateTime  @default(now())
  
  users              User[]
  meetings           Meeting[]
  actionPlans        ActionPlan[]
}

model User {
  id         String    @id @default(uuid())
  name       String
  email      String    @unique
  password   String
  role       Role      @default(ORGANIZER)
  status     Status    @default(ACTIVE)
  position   String?   @default("Técnico em Segurança do Trabalho")
  company    String?
  photoURL   String?
  createdAt  DateTime  @default(now())
  
  companyId  String?
  companyRel Company?  @relation(fields: [companyId], references: [id])
  meetings   Meeting[]
  quizzes    Quiz[]

  // Relações do Módulo de Planos de Ação
  createdActionPlans          ActionPlan[]                  @relation("ActionPlanCreator")
  responsibleActionPlans      ActionPlan[]                  @relation("ActionPlanResponsible")
  supervisedActionPlans       ActionPlan[]                  @relation("ActionPlanSupervisor")
  verifierActionPlans         ActionPlan[]                  @relation("ActionPlanVerifier")
  taskResponsibilities        ActionPlanTask[]              @relation("TaskResponsible")
  actionPlanAttachments       ActionPlanAttachment[]        @relation("AttachmentAuthor")
  actionPlanComments          ActionPlanComment[]           @relation("CommentAuthor")
  actionPlanHistoryEntries    ActionPlanHistory[]           @relation("HistoryUser")
  extensionRequests           ActionPlanDeadlineExtension[] @relation("ExtensionRequester")
  extensionApprovals          ActionPlanDeadlineExtension[] @relation("ExtensionApprover")
  actionPlanVerifications     ActionPlanVerification[]      @relation("VerificationVerifier")
  actionPlanNotifications     ActionPlanNotification[]      @relation("NotificationUser")
}

model Meeting {
  id                  String              @id @default(uuid())
  topic               String
  farm                String
  status              String              @default("LIVE")
  createdAt           DateTime            @default(now())
  inviteExpiresAt     DateTime?
  inviteToken         String?
  organizerId         String?
  organizer           User?               @relation(fields: [organizerId], references: [id])
  companyId           String?
  company             Company?            @relation(fields: [companyId], references: [id])
  type                String?             @default("REMOTE")
  groupPhoto          String?
  objective           String?
  programmaticContent String?
  endedAt             DateTime?
  instructorName      String?
  classification      String?             @default("DDS")
  documentHash        String?
  attendees           Attendance[]
  attachments         MeetingAttachment[]
  quizzes             Quiz[]
  actionPlans         ActionPlan[]

  @@index([organizerId, status, createdAt(sort: Desc)])
  @@index([companyId])
}

model Attendance {
  id            String    @id @default(uuid())
  name          String
  cpf           String
  selfie        String
  signature     String
  exitReason    String?
  exitSignature String?
  leftAt        DateTime?
  createdAt     DateTime  @default(now())
  meetingId     String
  meeting       Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  quizAttempts  QuizAttempt[]
  quizProofHash String?

  @@index([meetingId, createdAt])
}

model MeetingAttachment {
  id          String   @id @default(uuid())
  fileName    String
  displayName String?
  description String?
  mimeType    String
  fileSize    Int
  fileData    String
  pageCount   Int?     @default(1)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  meetingId   String
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, order])
}

model Quiz {
  id            String         @id @default(uuid())
  meetingId     String?
  meeting       Meeting?       @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  creatorId     String?
  creator       User?          @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  title         String
  status        String         @default("DRAFT")
  passingScore  Int            @default(70)
  criticalBelow Int            @default(40)
  excellentFrom Int            @default(90)
  shareToken    String         @unique @default(uuid())
  isTemplate    Boolean        @default(false)
  templateId    String?
  showRanking   Boolean        @default(false)
  createdAt     DateTime       @default(now())
  publishedAt   DateTime?
  closedAt      DateTime?
  questions     QuizQuestion[]
  attempts      QuizAttempt[]

  @@index([meetingId])
  @@index([creatorId])
  @@index([isTemplate])
  @@index([templateId])
}

model QuizQuestion {
  id          String       @id @default(uuid())
  quizId      String
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  text        String
  type        String       @default("SINGLE_CHOICE")
  weight      Int          @default(1)
  position    Int
  explanation String?
  options     QuizOption[]
  answers     QuizAnswer[]

  @@index([quizId, position])
}

model QuizOption {
  id         String       @id @default(uuid())
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean      @default(false)
  position   Int

  @@index([questionId, position])
}

model QuizAttempt {
  id               String       @id @default(uuid())
  quizId           String
  quiz             Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  attendanceId     String?
  attendance       Attendance?  @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  participantName  String?
  participantDoc   String?
  participantRegistration String? // matrícula de 4 dígitos; nulo para respostas históricas
  score            Float
  earnedPoints     Int
  possiblePoints   Int
  passed           Boolean
  level            String
  submittedAt      DateTime     @default(now())
  timeSpentSeconds Int?
  answers          QuizAnswer[]

  @@index([quizId, submittedAt])
  @@index([attendanceId])
  @@index([participantRegistration])
}

model QuizAnswer {
  id                String       @id @default(uuid())
  attemptId         String
  attempt           QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId        String
  question          QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionIds Json
  correct           Boolean
  earnedPoints      Int

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

// =========================================================================
// MÓDULO DE PLANOS DE AÇÃO (SST / QUALIDADE / NÃO CONFORMIDADES)
// =========================================================================

enum ActionPlanStatus {
  OPEN
  IN_PROGRESS
  AWAITING_VALIDATION
  COMPLETED
  SUSPENDED
  CANCELLED
  REOPENED
}

enum ActionPlanPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ActionPlanOrigin {
  DDS
  INSPECTION
  AUDIT
  NON_CONFORMITY
  INCIDENT
  ACCIDENT
  PREVENTIVE_OBSERVATION
  QUESTIONNAIRE
  OTHER
}

enum ActionPlanCriticality {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum VerificationResult {
  EFFECTIVE
  PARTIALLY_EFFECTIVE
  INEFFECTIVE
  PENDING
}

model ActionPlan {
  id                    String                 @id @default(uuid())
  code                  String                 @unique
  title                 String
  description           String?
  companyId             String
  company               Company                @relation(fields: [companyId], references: [id])
  sector                String?
  location              String?
  identificationDate    DateTime               @default(now())
  origin                ActionPlanOrigin       @default(OTHER)
  originReferenceId     String?
  meetingId             String?
  meeting               Meeting?               @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  category              String?
  criticality           ActionPlanCriticality  @default(MEDIUM)
  status                ActionPlanStatus       @default(OPEN)
  priority              ActionPlanPriority     @default(MEDIUM)

  // Descrição do problema / Investigação
  problemDescription    String?
  identifiedRisk        String?
  potentialConsequences String?
  identifiedCause       String?
  rootCause             String?
  immediateMeasures     String?
  additionalNotes       String?

  // Ação proposta (5W2H)
  actionDescription     String?
  actionObjective       String?
  expectedResult        String?
  requiredResources     String?
  completionCriteria    String?

  // Atribuições e Responsáveis
  creatorId             String
  creator               User                   @relation("ActionPlanCreator", fields: [creatorId], references: [id])
  responsibleId         String?
  responsible           User?                  @relation("ActionPlanResponsible", fields: [responsibleId], references: [id])
  supervisorId          String?
  supervisor            User?                  @relation("ActionPlanSupervisor", fields: [supervisorId], references: [id])
  verifierId            String?
  verifier              User?                  @relation("ActionPlanVerifier", fields: [verifierId], references: [id])

  // Prazos e Datas
  startDate             DateTime?
  dueDate               DateTime?
  completedAt           DateTime?
  originalDueDate       DateTime?

  // Controle inteligente de alertas (dias antes)
  alertDaysBefore       Int                    @default(7)

  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  // Relações do plano
  tasks                 ActionPlanTask[]
  attachments           ActionPlanAttachment[]
  comments              ActionPlanComment[]
  history               ActionPlanHistory[]
  extensions            ActionPlanDeadlineExtension[]
  verification          ActionPlanVerification?
  notifications         ActionPlanNotification[]

  @@index([companyId])
  @@index([creatorId])
  @@index([responsibleId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([createdAt])
  @@index([companyId, status])
  @@index([companyId, responsibleId])
  @@index([companyId, dueDate])
}

model ActionPlanTask {
  id            String           @id @default(uuid())
  actionPlanId  String
  actionPlan    ActionPlan       @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)
  description   String
  responsibleId String?
  responsible   User?            @relation("TaskResponsible", fields: [responsibleId], references: [id])
  dueDate       DateTime?
  status        ActionPlanStatus @default(OPEN)
  weight        Int              @default(1)
  notes         String?
  position      Int              @default(0)
  completedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  attachments   ActionPlanAttachment[]

  @@index([actionPlanId, position])
  @@index([responsibleId])
}

model ActionPlanAttachment {
  id           String          @id @default(uuid())
  actionPlanId String?
  actionPlan   ActionPlan?     @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)
  taskId       String?
  task         ActionPlanTask? @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName     String
  displayName  String?
  mimeType     String
  fileSize     Int
  fileData     String
  caption      String?
  evidenceType String?         // BEFORE, DURING, AFTER, COMPLEMENTARY
  authorId     String?
  author       User?           @relation("AttachmentAuthor", fields: [authorId], references: [id])
  notes        String?
  createdAt    DateTime        @default(now())

  @@index([actionPlanId])
  @@index([taskId])
}

model ActionPlanComment {
  id           String     @id @default(uuid())
  actionPlanId String
  actionPlan   ActionPlan @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)
  authorId     String
  author       User       @relation("CommentAuthor", fields: [authorId], references: [id])
  content      String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([actionPlanId, createdAt])
}

model ActionPlanHistory {
  id            String     @id @default(uuid())
  actionPlanId  String
  actionPlan    ActionPlan @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)
  userId        String
  user          User       @relation("HistoryUser", fields: [userId], references: [id])
  action        String     // CREATED, EDITED, STATUS_CHANGED, DEADLINE_CHANGED, RESPONSIBLE_CHANGED, PHOTO_ADDED, PHOTO_REMOVED, COMMENT_ADDED, EXTENSION_REQUESTED, EXTENSION_APPROVED, EXTENSION_REJECTED, REOPENED, COMPLETED, VERIFIED
  previousValue String?
  newValue      String?
  details       String?
  createdAt     DateTime   @default(now())

  @@index([actionPlanId, createdAt])
}

model ActionPlanDeadlineExtension {
  id               String     @id @default(uuid())
  actionPlanId     String
  actionPlan       ActionPlan @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)
  requesterId      String
  requester        User       @relation("ExtensionRequester", fields: [requesterId], references: [id])
  currentDueDate   DateTime
  requestedDueDate DateTime
  justification    String
  evidenceData     String?
  status           String     @default("PENDING") // PENDING, APPROVED, REJECTED
  approverId       String?
  approver         User?      @relation("ExtensionApprover", fields: [approverId], references: [id])
  approvalNotes    String?
  approvedAt       DateTime?
  createdAt        DateTime   @default(now())

  @@index([actionPlanId])
  @@index([status])
}

model ActionPlanVerification {
  id           String             @id @default(uuid())
  actionPlanId String             @unique
  actionPlan   ActionPlan         @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)
  verifierId   String
  verifier     User               @relation("VerificationVerifier", fields: [verifierId], references: [id])
  result       VerificationResult @default(PENDING)
  evidenceData String?
  notes        String?
  verifiedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model ActionPlanNotification {
  id           String     @id @default(uuid())
  actionPlanId String
  actionPlan   ActionPlan @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation("NotificationUser", fields: [userId], references: [id])
  type         String     // NEW_ASSIGNMENT, DUE_APPROACHING, OVERDUE, RESPONSIBLE_CHANGED, EXTENSION_REQUESTED, SENT_FOR_VALIDATION, APPROVED, RETURNED
  title        String
  message      String
  read         Boolean    @default(false)
  readAt       DateTime?
  createdAt    DateTime   @default(now())

  @@index([userId, read])
  @@index([actionPlanId])
  @@index([createdAt])
}
