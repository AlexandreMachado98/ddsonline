generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                 String    @id @default(uuid())
  name               String
  document           String?
  status             Status    @default(ACTIVE)
  secretKey          String?
  autoApproveWithKey Boolean   @default(true)
  createdAt          DateTime  @default(now())
  meetings           Meeting[]
  users              User[]
}

model User {
  id         String    @id @default(uuid())
  name       String
  email      String    @unique
  password   String
  role       Role      @default(ORGANIZER)
  status     Status    @default(ACTIVE)
  position   String?   @default("Técnico em Segurança do Trabalho")
  company    String?
  photoURL   String?
  createdAt  DateTime  @default(now())
  companyId  String?
  meetings   Meeting[]
  companyRel Company?  @relation(fields: [companyId], references: [id])
}

model Meeting {
  id              String       @id @default(uuid())
  topic           String
  farm            String
  status          String       @default("LIVE")
  createdAt       DateTime     @default(now())
  inviteExpiresAt DateTime?
  inviteToken     String?
  organizerId     String?
  companyId       String?
  type            String       @default("PRESENTIAL")
  objective       String?
  teamPhotos      String?
  attendees       Attendance[]
  company         Company?     @relation(fields: [companyId], references: [id])
  organizer       User?        @relation(fields: [organizerId], references: [id])
}

model Attendance {
  id            String    @id @default(uuid())
  name          String
  cpf           String
  selfie        String
  signature     String
  exitReason    String?
  exitSignature String?
  leftAt        DateTime?
  createdAt     DateTime  @default(now())
  meetingId     String
  status        String    @default("ADMITTED")
  meeting       Meeting   @relation(fields: [meetingId], references: [id])
}

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  ORGANIZER
}

enum Status {
  ACTIVE
  PENDING_APPROVAL
  SUSPENDED
  BLOCKED
}
