generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  ORGANIZER
}

enum Status {
  ACTIVE
  PENDING_APPROVAL
  SUSPENDED
  BLOCKED
}

model Company {
  id                 String    @id @default(uuid())
  name               String
  document           String?
  status             Status    @default(ACTIVE)
  secretKey          String?
  autoApproveWithKey Boolean   @default(true)
  createdAt          DateTime  @default(now())
  
  users              User[]
  meetings           Meeting[]
}

model User {
  id         String    @id @default(uuid())
  name       String
  email      String    @unique
  password   String
  role       Role      @default(ORGANIZER)
  status     Status    @default(ACTIVE)
  position   String?   @default("Técnico em Segurança do Trabalho")
  company    String?
  photoURL   String?
  createdAt  DateTime  @default(now())
  
  companyId  String?
  companyRel Company?  @relation(fields: [companyId], references: [id])
  meetings   Meeting[]
}

model Meeting {
  id              String       @id @default(uuid())
  topic           String
  farm            String
  status          String       @default("LIVE")
  createdAt       DateTime     @default(now())
  inviteExpiresAt DateTime?
  inviteToken     String?
  organizerId     String?
  organizer       User?        @relation(fields: [organizerId], references: [id])
  companyId       String?
  company         Company?     @relation(fields: [companyId], references: [id])
  type            String?      @default("REMOTE")
  groupPhoto          String?
  objective           String?
  programmaticContent String?
  endedAt             DateTime?
  instructorName      String?
  classification      String?      @default("DDS")
  documentHash        String?
  attendees           Attendance[]
  attachments         MeetingAttachment[]
  quizzes              Quiz[]

  @@index([organizerId, status, createdAt(sort: Desc)])
  @@index([companyId])
}

model Attendance {
  id            String    @id @default(uuid())
  name          String
  cpf           String
  selfie        String
  signature     String
  exitReason    String?
  exitSignature String?
  leftAt        DateTime?
  createdAt     DateTime  @default(now())
  meetingId     String
  meeting       Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  quizAttempts QuizAttempt[]

  @@index([meetingId, createdAt])
}

model MeetingAttachment {
  id          String   @id @default(uuid())
  fileName    String
  displayName String?
  description String?
  mimeType    String
  fileSize    Int
  fileData    String
  pageCount   Int?     @default(1)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  meetingId   String
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, order])
}
model Quiz {
  id            String         @id @default(uuid())
  meetingId     String
  meeting       Meeting        @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  title         String
  status        String         @default("DRAFT")
  passingScore  Int            @default(70)
  criticalBelow Int            @default(40)
  excellentFrom Int            @default(90)
  shareToken    String         @unique @default(uuid())
  createdAt     DateTime       @default(now())
  publishedAt   DateTime?
  closedAt      DateTime?
  questions     QuizQuestion[]
  attempts      QuizAttempt[]

  @@index([meetingId])
}

model QuizQuestion {
  id          String       @id @default(uuid())
  quizId      String
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  text        String
  type        String       @default("SINGLE_CHOICE")
  weight      Int          @default(1)
  position    Int
  explanation String?
  options     QuizOption[]
  answers     QuizAnswer[]

  @@index([quizId, position])
}

model QuizOption {
  id         String       @id @default(uuid())
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean      @default(false)
  position   Int

  @@index([questionId, position])
}

model QuizAttempt {
  id            String       @id @default(uuid())
  quizId        String
  quiz          Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  attendanceId  String
  attendance    Attendance   @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  score         Float
  earnedPoints  Int
  possiblePoints Int
  passed        Boolean
  level         String
  submittedAt   DateTime     @default(now())
  answers       QuizAnswer[]

  @@unique([quizId, attendanceId])
  @@index([quizId, submittedAt])
}

model QuizAnswer {
  id                String       @id @default(uuid())
  attemptId         String
  attempt           QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId        String
  question          QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionIds Json
  correct           Boolean
  earnedPoints      Int

  @@unique([attemptId, questionId])
  @@index([attemptId])
}
